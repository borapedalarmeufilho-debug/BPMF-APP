<?xml version="1.0" encoding="UTF-8"?><gpx creator="Wikiloc - http://www.wikiloc.com" version="1.1" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><metadata><name><![CDATA[Rota da luz em 3 dias - dia 3 - Redenção da Serra - Santuário Nacional de Nossa Senhora Aparecida 14/10/23]]></name><author><name><![CDATA[Glau Ferreira]]></name><link href="https://www.wikiloc.com/wikiloc/user.do?id=10924546"><text><![CDATA[Glau Ferreira on Wikiloc]]></text></link></author><link href="https://www.wikiloc.com/wikiloc/view.do?id=150326749"><text><![CDATA[Rota da luz em 3 dias - dia 3 - Redenção da Serra - Santuário Nacional de Nossa Senhora Aparecida 14/10/23 on Wikiloc]]></text></link><time>2023-10-14T12:40:45Z</time></metadata><wpt lat="-23.185419" lon="-45.548392"><ele>805.0</ele><name><![CDATA[Apoio com café dona Cida]]></name><cmt><![CDATA[Apoio com café dona Cida]]></cmt></wpt><wpt lat="-23.032071" lon="-45.472292"><ele>615.0</ele><name><![CDATA[Pico]]></name><cmt><![CDATA[Pico]]></cmt></wpt><wpt lat="-22.992524" lon="-45.456653"><ele>587.0</ele><name><![CDATA[Restaurante delícias do cafundó comida mineira]]></name><cmt><![CDATA[Restaurante delícias do cafundó comida mineira]]></cmt></wpt><trk><name><![CDATA[Rota da luz em 3 dias - dia 3 - Redenção da Serra - Santuário Nacional de Nossa Senhora Aparecida 14/10/23]]></name><cmt><![CDATA[Trilha de Redenção da Serra a Santuário Nacional de Nossa Senhora Aparecida. Dia misto pedal terra e asfalto com a famosa subida do batman, passando por Taubaté, Pindamonhangaba, roseira e Aparecida. Optamos por dormir em aparecida no hotel santa ceia e voltar no dia seguinte. Chegamos em Aparecida por volta de 17:30h com parada pro almoço em meio a trilha após Taubaté no restaurante Caipira na estrada de terra.]]></cmt><desc><![CDATA[Trilha de Redenção da Serra a Santuário Nacional de Nossa Senhora Aparecida. Dia misto pedal terra e asfalto com a famosa subida do batman, passando por Taubaté, Pindamonhangaba, roseira e Aparecida. Optamos por dormir em aparecida no hotel santa ceia e voltar no dia seguinte. Chegamos em Aparecida por volta de 17:30h com parada pro almoço em meio a trilha após Taubaté no restaurante Caipira na estrada de terra.]]></desc><trkseg><trkpt lat="-23.280386999999997" lon="-45.560835"><ele>739.253</ele><time>2023-10-14T12:40:45Z</time></trkpt><trkpt lat="-23.280392" lon="-45.560781999999996"><ele>745.504</ele><time>2023-10-14T12:40:58Z</time></trkpt><trkpt lat="-23.280413" lon="-45.560717"><ele>751.714</ele><time>2023-10-14T12:41:00Z</time></trkpt><trkpt lat="-23.280441" lon="-45.560668"><ele>751.709</ele><time>2023-10-14T12:41:02Z</time></trkpt><trkpt lat="-23.280469" lon="-45.560612"><ele>751.746</ele><time>2023-10-14T12:41:04Z</time></trkpt><trkpt lat="-23.280498" lon="-45.560551"><ele>751.740</ele><time>2023-10-14T12:41:06Z</time></trkpt><trkpt lat="-23.280523000000002" lon="-45.560494999999996"><ele>751.715</ele><time>2023-10-14T12:41:08Z</time></trkpt><trkpt lat="-23.280534000000003" lon="-45.560446999999996"><ele>751.658</ele><time>2023-10-14T12:41:10Z</time></trkpt><trkpt lat="-23.280545000000004" lon="-45.560356"><ele>751.447</ele><time>2023-10-14T12:41:12Z</time></trkpt><trkpt lat="-23.280576000000003" lon="-45.5603"><ele>751.181</ele><time>2023-10-14T12:41:14Z</time></trkpt><trkpt lat="-23.280585000000002" lon="-45.560246"><ele>750.912</ele><time>2023-10-14T12:41:16Z</time></trkpt><trkpt lat="-23.280590000000004" lon="-45.560190999999996"><ele>750.799</ele><time>2023-10-14T12:41:18Z</time></trkpt><trkpt lat="-23.280605000000005" lon="-45.560115999999994"><ele>750.674</ele><time>2023-10-14T12:41:20Z</time></trkpt><trkpt lat="-23.280615000000004" lon="-45.560050999999994"><ele>750.517</ele><time>2023-10-14T12:41:22Z</time></trkpt><trkpt lat="-23.280624000000003" lon="-45.559968999999995"><ele>750.587</ele><time>2023-10-14T12:41:2