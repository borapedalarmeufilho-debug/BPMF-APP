<?xml version="1.0" encoding="UTF-8"?><gpx creator="Wikiloc - http://www.wikiloc.com" version="1.1" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><metadata><name><![CDATA[Rota da luz em 3 dias - Mogi até Santa Branca- Dia 1 - junho 23]]></name><author><name><![CDATA[Glau Ferreira]]></name><link href="https://www.wikiloc.com/wikiloc/user.do?id=10924546"><text><![CDATA[Glau Ferreira on Wikiloc]]></text></link></author><link href="https://www.wikiloc.com/wikiloc/view.do?id=137151916"><text><![CDATA[Rota da luz em 3 dias - Mogi até Santa Branca- Dia 1 - junho 23 on Wikiloc]]></text></link><time>2023-06-08T13:43:41Z</time></metadata><wpt lat="-23.510507" lon="-46.171082"><ele>737.0</ele><name><![CDATA[Parque centenário]]></name><cmt><![CDATA[Parque centenário]]></cmt></wpt><wpt lat="-23.508949" lon="-46.171719"><ele>733.0</ele><name><![CDATA[Waypoint]]></name><cmt><![CDATA[Waypoint]]></cmt></wpt><wpt lat="-23.458986" lon="-46.058983"><ele>618.0</ele><name><![CDATA[Luís Carlos guararema]]></name><cmt><![CDATA[Luís Carlos guararema]]></cmt></wpt><wpt lat="-23.458796" lon="-46.058405"><ele>626.0</ele><name><![CDATA[Waypoint]]></name><cmt><![CDATA[Waypoint]]></cmt></wpt><wpt lat="-23.442896" lon="-46.034526"><ele>722.0</ele><name><![CDATA[Mirante do zecão]]></name><cmt><![CDATA[Mirante do zecão]]></cmt></wpt><wpt lat="-23.414177" lon="-46.031604"><ele>582.0</ele><name><![CDATA[Estação Guararema]]></name><cmt><![CDATA[Estação Guararema]]></cmt></wpt><wpt lat="-23.419017" lon="-45.980003"><ele>583.0</ele><name><![CDATA[Waypoint]]></name><cmt><![CDATA[Waypoint]]></cmt></wpt><trk><name><![CDATA[Rota da luz em 3 dias - Mogi até Santa Branca- Dia 1 - junho 23]]></name><cmt><![CDATA[Dia 01 saímos de São Paulo pelo metrô luz pegando o trem sentido estação Estudantes - Mogi. De lá iniciamos o percurso da Rota da Luz. Inicialmente paramos no Parque Centenário onde tiramos umas belas fotos. Seguimos sentido Luís Carlos, Guararema e depois Santa branca. Nos hospedamos no @pedalamoscicloturismo. O Pedro é muito bacana e nos recebeu super bem. E amanhã tem mais …seguiremos sentido Redenção da Serra.]]></cmt><desc><![CDATA[Dia 01 saímos de São Paulo pelo metrô luz pegando o trem sentido estação Estudantes - Mogi. De lá iniciamos o percurso da Rota da Luz. Inicialmente paramos no Parque Centenário onde tiramos umas belas fotos. Seguimos sentido Luís Carlos, Guararema e depois Santa branca. Nos hospedamos no @pedalamoscicloturismo. O Pedro é muito bacana e nos recebeu super bem. E amanhã tem mais …seguiremos sentido Redenção da Serra.]]></desc><trkseg><trkpt lat="-23.514696999999998" lon="-46.183842"><ele>739.811</ele><time>2023-06-08T13:43:41Z</time></trkpt><trkpt lat="-23.514718" lon="-46.183907"><ele>739.821</ele><time>2023-06-08T13:45:47Z</time></trkpt><trkpt lat="-23.514718" lon="-46.183957"><ele>739.803</ele><time>2023-06-08T13:45:50Z</time></trkpt><trkpt lat="-23.514667" lon="-46.184006"><ele>739.809</ele><time>2023-06-08T13:45:53Z</time></trkpt><trkpt lat="-23.514609" lon="-46.184034999999994"><ele>739.892</ele><time>2023-06-08T13:45:56Z</time></trkpt><trkpt lat="-23.514566" lon="-46.184006999999994"><ele>739.814</ele><time>2023-06-08T13:46:09Z</time></trkpt><trkpt lat="-23.514612" lon="-46.18399099999999"><ele>739.848</ele><time>2023-06-08T13:47:39Z</time></trkpt><trkpt lat="-23.514581" lon="-46.18395299999999"><ele>739.822</ele><time>2023-06-08T13:49:08Z</time></trkpt><trkpt lat="-23.514579" lon="-46.18388999999999"><ele>739.836</ele><time>2023-06-08T13:49:11Z</time></trkpt><trkpt lat="-23.514561" lon="-46.18383099999999"><ele>739.852</ele><time>2023-06-08T13:49:14Z</time></trkpt><trkpt lat="-23.514533" lon="-46.18376999999999"><ele>739.820</ele><time>2023-06-08T13:49:17Z</time></trkpt><trkpt lat="-23.514515" lon="-46.18371399999999"><ele>739.832</ele><time>2023-06-08T13:49:19Z</time></trkpt><trkpt